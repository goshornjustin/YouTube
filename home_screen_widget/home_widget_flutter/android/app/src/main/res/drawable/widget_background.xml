<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Use color resources instead of hard-coded hex so values-night/colors.xml
         is picked up automatically in dark mode. Hard-coded #FFFFFF looks broken
         on dark launchers or dark wallpapers. -->
    <solid android:color="@color/widget_background" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_stroke" />
</shape>
